rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user may create and read only their own basic profile.
    // Profile fields are deliberately limited; clients cannot grant themselves
    // a subscription or change server-managed account data.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // Profile edits and deletion are not currently needed by the app.
      allow update, delete: if false;
    }

    // Entitlements are written only by trusted server code (Firebase Admin SDK).
    // The account owner may read their own entitlement; clients cannot write it.
    match /entitlements/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // No other client access is granted by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
