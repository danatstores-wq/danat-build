rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdvertiserAdmin() {
      return signedIn()
        && request.auth.uid == 'psu8GgwqNUSKHSQER9wkcEKbbz22';
    }

    function validCampaign(data) {
      return data.keys().hasAll([
          'countryCode', 'advertiserName', 'imageUrl',
          'clickUrl', 'startsAt', 'endsAt', 'active',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'countryCode', 'advertiserName', 'imageUrl',
          'clickUrl', 'startsAt', 'endsAt', 'active',
          'createdAt', 'updatedAt'
        ])
        && data.countryCode in [
          'LB', 'AE', 'SA', 'QA', 'KW',
          'OM', 'BH', 'EG', 'IQ'
        ]
        && data.advertiserName is string
        && data.imageUrl is string
        && data.imageUrl.matches('https://.*')
        && data.clickUrl is string
        && data.clickUrl.matches('https://.*')
        && data.startsAt is timestamp
        && data.endsAt is timestamp
        && data.endsAt > data.startsAt
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if signedIn()
        && request.auth.uid == userId;

      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'createdAt', 'updatedAt',
          'constructionDisclaimerAccepted',
          'constructionDisclaimerVersion',
          'constructionDisclaimerAcceptedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'createdAt', 'updatedAt',
          'constructionDisclaimerAccepted',
          'constructionDisclaimerVersion',
          'constructionDisclaimerAcceptedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.constructionDisclaimerAccepted == true
        && request.resource.data.constructionDisclaimerVersion == '2026-11-26'
        && request.resource.data.constructionDisclaimerAcceptedAt == request.time;

      allow update, delete: if false;
    }

    match /directAdCampaigns/{campaignId} {
      allow get, list: if isAdvertiserAdmin()
        || resource.data.active == true;

      allow create: if isAdvertiserAdmin()
        && validCampaign(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdvertiserAdmin()
        && validCampaign(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdvertiserAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}