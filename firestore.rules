rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdvertiserAdmin() {
      return signedIn() && request.auth.token.advertiserAdmin == true;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt', 'constructionDisclaimerAccepted', 'constructionDisclaimerVersion', 'constructionDisclaimerAcceptedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt', 'constructionDisclaimerAccepted', 'constructionDisclaimerVersion', 'constructionDisclaimerAcceptedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.constructionDisclaimerAccepted == true
        && request.resource.data.constructionDisclaimerVersion == '2026-11-26'
        && request.resource.data.constructionDisclaimerAcceptedAt == request.time;

      allow update, delete: if false;
    }

    match /directAdCampaigns/{campaignId} {
      // App users can only read active campaign documents. Admins can manage all campaigns.
      allow get, list: if isAdvertiserAdmin() || resource.data.active == true;
      allow create: if isAdvertiserAdmin()
        && request.resource.data.keys().hasAll(['countryCode', 'advertiserName', 'imageUrl', 'clickUrl', 'startsAt', 'endsAt', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['countryCode', 'advertiserName', 'imageUrl', 'clickUrl', 'startsAt', 'endsAt', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.countryCode in ['LB', 'AE', 'SA', 'QA', 'KW', 'OM', 'BH', 'EG', 'IQ']
        && request.resource.data.advertiserName is string
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('https://.*')
        && request.resource.data.clickUrl is string
        && request.resource.data.clickUrl.matches('https://.*')
        && request.resource.data.startsAt is timestamp
        && request.resource.data.endsAt is timestamp
        && request.resource.data.endsAt > request.resource.data.startsAt
        && request.resource.data.active is bool;
      allow update: if isAdvertiserAdmin()
        && request.resource.data.keys().hasOnly(['countryCode', 'advertiserName', 'imageUrl', 'clickUrl', 'startsAt', 'endsAt', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.countryCode in ['LB', 'AE', 'SA', 'QA', 'KW', 'OM', 'BH', 'EG', 'IQ']
        && request.resource.data.advertiserName is string
        && request.resource.data.imageUrl.matches('https://.*')
        && request.resource.data.clickUrl.matches('https://.*')
        && request.resource.data.startsAt is timestamp
        && request.resource.data.endsAt is timestamp
        && request.resource.data.endsAt > request.resource.data.startsAt
        && request.resource.data.active is bool;
      allow delete: if isAdvertiserAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}