# Firebase public app configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=danat-build
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# RevenueCat public SDK keys (safe to bundle in the app)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Keep REVENUECAT_WEBHOOK_AUTHORIZATION out of this file and out of the app.
# Set it only as a Firebase Functions secret.

# AdMob app IDs are used at native build time by app.config.js.
# Keep the test defaults during development; replace with your own app IDs before release.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=

# AdMob banner unit IDs (public). Leave blank in production until real units exist.
# Development builds automatically use Google's official test banner unit.
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
