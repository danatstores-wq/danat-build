rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /directAdBanners/{adminUid}/{fileName} {
      // Banner images are public because they are displayed to app users.
      allow read: if true;

      // Only the designated Danat Build administrator may upload or replace banners.
      allow create, update: if request.auth != null
        && request.auth.uid == 'psu8GgwqNUSKHSQER9wkcEKbbz22'
        && adminUid == request.auth.uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if request.auth != null
        && request.auth.uid == 'psu8GgwqNUSKHSQER9wkcEKbbz22'
        && adminUid == request.auth.uid;
    }

    // Deny all other Storage paths by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
